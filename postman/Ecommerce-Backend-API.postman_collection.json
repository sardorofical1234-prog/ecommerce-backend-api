{
  "info": {
    "_postman_id": "87c21c73-6c31-4a86-b2b7-9b1f6c53d111",
    "name": "E-commerce Backend API",
    "description": "End-to-end local API workflow: admin bootstrap login, customer registration, product catalogue, cart, idempotent checkout/payment, decline/cancel, and admin maintenance. Fake payment only; no external paid services.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "customerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "customerEmail",
      "value": "",
      "type": "string"
    },
    {
      "key": "productSku",
      "value": "",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "",
      "type": "string"
    },
    {
      "key": "orderId",
      "value": "",
      "type": "string"
    },
    {
      "key": "paymentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "declineOrderId",
      "value": "",
      "type": "string"
    },
    {
      "key": "runSuffix",
      "value": "",
      "type": "string"
    },
    {
      "key": "checkoutKey",
      "value": "",
      "type": "string"
    },
    {
      "key": "paymentKey",
      "value": "",
      "type": "string"
    },
    {
      "key": "declineCheckoutKey",
      "value": "",
      "type": "string"
    },
    {
      "key": "declinePaymentKey",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Setup and identity",
      "item": [
        {
          "name": "Admin login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = Date.now().toString();",
                  "pm.collectionVariables.set(\"runSuffix\", suffix);",
                  "pm.collectionVariables.set(\"customerEmail\", \"buyer-\" + suffix + \"@example.com\");",
                  "pm.collectionVariables.set(\"productSku\", \"POSTMAN-\" + suffix);",
                  "pm.collectionVariables.set(\"checkoutKey\", \"checkout-\" + suffix);",
                  "pm.collectionVariables.set(\"paymentKey\", \"payment-\" + suffix);",
                  "pm.collectionVariables.set(\"declineCheckoutKey\", \"checkout-decline-\" + suffix);",
                  "pm.collectionVariables.set(\"declinePaymentKey\", \"payment-decline-\" + suffix);",
                  "[\"adminToken\",\"customerToken\",\"productId\",\"orderId\",\"paymentId\",\"declineOrderId\"].forEach(k => pm.collectionVariables.unset(k));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Admin login returns 200\", () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.expect(data.accessToken).to.be.a(\"string\");",
                  "pm.collectionVariables.set(\"adminToken\", data.accessToken);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Create demo product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"{{productSku}}\",\n  \"name\": \"Postman Demo Headphones\",\n  \"description\": \"Disposable local portfolio demo product\",\n  \"category\": \"Electronics\",\n  \"price\": 49.99,\n  \"stock\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/admin/products"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Product created\", () => pm.response.to.have.status(201));",
                  "const data = pm.response.json();",
                  "pm.expect(data.id).to.be.a(\"string\");",
                  "pm.collectionVariables.set(\"productId\", data.id);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Register customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\",\n  \"fullName\": \"Postman Demo Buyer\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/auth/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Customer registered\", () => pm.response.to.have.status(201));",
                  "const data = pm.response.json();",
                  "pm.expect(data.accessToken).to.be.a(\"string\");",
                  "pm.collectionVariables.set(\"customerToken\", data.accessToken);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Get current customer",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/users/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Authenticated customer profile\", () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.expect(data.roles).to.include(\"CUSTOMER\");"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Get created product",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/products/{{productId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Product is publicly readable\", () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json().sku).to.eql(pm.collectionVariables.get(\"productSku\"));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Search products",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/products?query=Headphones&page=0&size=10"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Product search returns 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "02 - Cart and checkout",
      "item": [
        {
          "name": "Add product to cart",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/cart/items"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Cart item added\", () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.expect(data.totalItems).to.be.at.least(1);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Get cart",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/cart"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Cart contains the demo product\", () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json().items.some(item => item.productId === pm.collectionVariables.get(\"productId\"))).to.eql(true);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Checkout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{checkoutKey}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/checkout"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Checkout creates a pending order\", () => pm.response.to.have.status(201));",
                  "const data = pm.response.json();",
                  "pm.expect(data.status).to.eql(\"PENDING_PAYMENT\");",
                  "pm.collectionVariables.set(\"orderId\", data.id);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Retry checkout with same key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{checkoutKey}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/checkout"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Checkout retry does not create another order\", () => pm.response.to.have.status(201));",
                  "pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get(\"orderId\"));"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "03 - Payment and order history",
      "item": [
        {
          "name": "Approve simulated payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{paymentKey}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scenario\": \"APPROVE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/orders/{{orderId}}/payments"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Payment is approved by the fake provider\", () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.expect(data.status).to.eql(\"SUCCEEDED\");",
                  "pm.collectionVariables.set(\"paymentId\", data.id);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Retry payment key with DECLINE body",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{paymentKey}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scenario\": \"DECLINE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/orders/{{orderId}}/payments"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Payment retry returns the original successful attempt\", () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get(\"paymentId\"));",
                  "pm.expect(pm.response.json().status).to.eql(\"SUCCEEDED\");"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Get payment history",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/orders/{{orderId}}/payments"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Payment history contains the successful attempt\", () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json().some(p => p.id === pm.collectionVariables.get(\"paymentId\"))).to.eql(true);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Get customer orders",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/orders"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Order history is readable\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Get paid order details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/orders/{{orderId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Order is paid\", () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json().status).to.eql(\"PAID\");"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "04 - Decline and cancellation",
      "item": [
        {
          "name": "Add another unit",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/cart/items"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Second cart item added\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Checkout second order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{declineCheckoutKey}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/checkout"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Second order created\", () => pm.response.to.have.status(201));",
                  "const data = pm.response.json();",
                  "pm.expect(data.status).to.eql(\"PENDING_PAYMENT\");",
                  "pm.collectionVariables.set(\"declineOrderId\", data.id);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Decline simulated payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{declinePaymentKey}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scenario\": \"DECLINE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/orders/{{declineOrderId}}/payments"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Fake provider declines payment\", () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json().status).to.eql(\"DECLINED\");"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Cancel pending order and release stock",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/orders/{{declineOrderId}}/cancel"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Pending order is cancelled\", () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json().status).to.eql(\"CANCELLED\");"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "05 - Admin product maintenance",
      "item": [
        {
          "name": "Update demo product",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Demo Headphones - Updated\",\n  \"description\": \"Updated local portfolio demo product\",\n  \"category\": \"Electronics\",\n  \"price\": 54.99,\n  \"stock\": 9\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/admin/products/{{productId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Admin updates product\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Deactivate demo product",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/admin/products/{{productId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Admin deactivates product\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    }
  ]
}
