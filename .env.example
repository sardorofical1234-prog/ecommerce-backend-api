# Change this before running locally.
DB_PASSWORD=replace-with-a-long-local-db-password

# Generate with: openssl rand -base64 32
JWT_SECRET_BASE64=REPLACE_WITH_BASE64_32_BYTE_SECRET

# Rate limiting backend: redis for shared counters; memory is single-instance only.
RATE_LIMIT_BACKEND=redis

# Leave empty for the local Compose Redis. Set the managed Redis credentials in the deployment secret store.
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false

# Required for Prometheus scraping. Generate: openssl rand -hex 32
METRICS_SCRAPE_TOKEN=

# Optional: enable only when you need to manage the product catalog.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FULL_NAME="Store Administrator"
